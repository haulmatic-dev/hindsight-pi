[Unit]
Description=Hydra Agent Orchestrator
Documentation=https://github.com/haulmatic-dev/hydra
After=network.target mcp-server.service cass-memory.service
Wants=network.target

[Service]
Type=simple
User=hydra
Group=hydra
WorkingDirectory=/opt/dev-tools/var/hydra

# Environment
Environment="HYDRA_CONFIG=/etc/hydra/hydra.yaml"
Environment="HYDRA_HOME=/opt/dev-tools/var/hydra"
Environment="PATH=/opt/dev-tools/components/infra/services/beads-rust/beads_rust/target/release:/opt/dev-tools/components/infra/services/beads-viewer/beads_viewer:/usr/local/bin:/usr/bin:/bin:/opt/dev-tools/var/hydra/bin"
EnvironmentFile=/etc/hydra/api-keys.env
Environment="HYDRA_ENVIRONMENT=production"

# Main executable
ExecStart=/opt/dev-tools/var/hydra/bin/hydra -config /etc/hydra/hydra.yaml
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

# Graceful shutdown
TimeoutStopSec=60
KillSignal=SIGTERM
SendSIGKILL=yes

# Resource limits
LimitNOFILE=65536
LimitNPROC=8192
# LimitAS removed: hydra + TLDR + cgo libraries blow past 2GB virtual address space

# Security
NoNewPrivileges=false
PrivateTmp=false
ProtectSystem=false
ProtectHome=false

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# Logging
StandardOutput=append:/var/log/hydra/hydra.log
StandardError=append:/var/log/hydra/hydra-error.log
SyslogIdentifier=hydra

# Watchdog disabled: hydra binary does not call sd_notify(WATCHDOG=1).
# Re-enable when the binary supports systemd watchdog notifications.
# WatchdogSec=60s

[Install]
WantedBy=multi-user.target
